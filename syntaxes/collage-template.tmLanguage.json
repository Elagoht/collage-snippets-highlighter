{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Collage Template",
  "scopeName": "collage.template.injection",
  "comment": "Generated by scripts/build-grammar.mjs from data/catalog.json — edit those, not this.",
  "injectionSelector": "L:text.html -comment.block.html",
  "patterns": [
    {
      "include": "#action"
    }
  ],
  "repository": {
    "action": {
      "name": "meta.embedded.block.collage-template",
      "begin": "\\{\\{-?",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.collage-template"
        }
      },
      "end": "-?\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.collage-template"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "name": "keyword.control.collage-template",
          "match": "\\b(?:if|else|end|range|with|template|block|define|break|continue)\\b"
        },
        {
          "name": "support.function.collage.core",
          "match": "(?<![.$\\w])\\b(?:slot|hoist|asset|stylesheet|csrfToken|pageURL|pageURLIn|localeURL|actionURL|fragmentURL|fragmentURLIn|safeHTML|safeURL|dict|default|upper|lower|title|join|formatTime)\\b"
        },
        {
          "name": "support.function.collage.plugin",
          "match": "(?<![.$\\w])\\b(?:liveClient|oauthLogin|searchBox|offlineScript|cspNonce|flashes|t|th|tn|fieldError|fieldValue|hasErrors|honeypot|highlight|toc|readingTime|bundle)\\b"
        },
        {
          "name": "support.function.builtin.collage-template",
          "match": "(?<![.$\\w])\\b(?:and|or|not|len|index|slice|print|printf|println|eq|ne|lt|le|gt|ge|call|html|js|urlquery)\\b"
        },
        {
          "name": "constant.language.collage-template",
          "match": "\\b(?:true|false|nil)\\b"
        },
        {
          "name": "string.quoted.double.collage-template",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.collage-template",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.collage-template",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.single.collage-template",
          "match": "'(?:\\\\.|[^'\\\\])'"
        },
        {
          "name": "constant.numeric.collage-template",
          "match": "-?\\b\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.collage-template",
          "match": "\\$\\w*"
        },
        {
          "name": "variable.other.member.collage-template",
          "match": "\\.[A-Za-z_]\\w*"
        },
        {
          "name": "variable.language.dot.collage-template",
          "match": "(?<![\\w)])\\.(?![\\w])"
        },
        {
          "name": "keyword.operator.assignment.collage-template",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.pipe.collage-template",
          "match": "\\|"
        },
        {
          "name": "punctuation.section.parens.collage-template",
          "match": "[()]"
        }
      ]
    },
    "comment": {
      "name": "comment.block.collage-template",
      "begin": "/\\*",
      "end": "\\*/"
    }
  }
}
