{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Collage Inline Template",
  "scopeName": "collage.inline.injection",
  "comment": "Colours an inline template as HTML: the raw string among collage.NewInlineFragment's arguments, and the raw string of a const or var declared as collage.InlineHTML. Either may be written across lines: the call is followed to its closing parenthesis, and a declaration to its raw string, or to the first value that is not one. A declaration's rules start where Go's own const and var rules do, right after the keyword or at the line's start in a group, so that they win. The template scope names text.html.basic too, which is what lets collage.template.injection colour its {{...}} actions.",
  "injectionSelector": "L:source.go -comment -string",
  "patterns": [
    {
      "include": "#inline-fragment"
    },
    {
      "include": "#inline-html"
    }
  ],
  "repository": {
    "inline-fragment": {
      "comment": "NewInlineFragment( … ), its arguments on one line or several. Parentheses inside are balanced, so the call ends at its own.",
      "begin": "\\b(NewInlineFragment)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.go"
        },
        "2": {
          "name": "punctuation.definition.begin.bracket.round.go"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.bracket.round.go"
        }
      },
      "patterns": [
        {
          "include": "#raw-html"
        },
        {
          "include": "#parens"
        },
        {
          "include": "source.go"
        }
      ]
    },
    "inline-html": {
      "comment": "const x collage.InlineHTML = `...`, var x collage.InlineHTML = `...`, and a line of a const ( ... ) or var ( ... ) group; the raw string may start on the next line. Any other value ends the declaration.",
      "patterns": [
        {
          "begin": "(?<=\\bconst\\b)\\s*(\\b\\w+(?:\\s*,\\s*\\w+)*)\\s+((?:\\w+\\s*\\.\\s*)?InlineHTML)\\s*(=)",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "match": ",",
                  "name": "punctuation.other.comma.go"
                },
                {
                  "match": "\\w+",
                  "name": "variable.other.constant.go"
                }
              ]
            },
            "2": {
              "patterns": [
                {
                  "match": "\\.",
                  "name": "punctuation.other.period.go"
                },
                {
                  "match": "\\w+",
                  "name": "entity.name.type.go"
                }
              ]
            },
            "3": {
              "name": "keyword.operator.assignment.go"
            }
          },
          "end": "(?<=`)|(?=[^\\s`])",
          "patterns": [
            {
              "include": "#raw-html"
            }
          ]
        },
        {
          "begin": "(?<=\\bvar\\b)\\s*(\\b\\w+(?:\\s*,\\s*\\w+)*)\\s+((?:\\w+\\s*\\.\\s*)?InlineHTML)\\s*(=)",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "match": ",",
                  "name": "punctuation.other.comma.go"
                },
                {
                  "match": "\\w+",
                  "name": "variable.other.assignment.go"
                }
              ]
            },
            "2": {
              "patterns": [
                {
                  "match": "\\.",
                  "name": "punctuation.other.period.go"
                },
                {
                  "match": "\\w+",
                  "name": "entity.name.type.go"
                }
              ]
            },
            "3": {
              "name": "keyword.operator.assignment.go"
            }
          },
          "end": "(?<=`)|(?=[^\\s`])",
          "patterns": [
            {
              "include": "#raw-html"
            }
          ]
        },
        {
          "begin": "^\\s*(\\b\\w+(?:\\s*,\\s*\\w+)*)\\s+((?:\\w+\\s*\\.\\s*)?InlineHTML)\\s*(=)",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "match": ",",
                  "name": "punctuation.other.comma.go"
                },
                {
                  "match": "\\w+",
                  "name": "variable.other.constant.go"
                }
              ]
            },
            "2": {
              "patterns": [
                {
                  "match": "\\.",
                  "name": "punctuation.other.period.go"
                },
                {
                  "match": "\\w+",
                  "name": "entity.name.type.go"
                }
              ]
            },
            "3": {
              "name": "keyword.operator.assignment.go"
            }
          },
          "end": "(?<=`)|(?=[^\\s`])",
          "patterns": [
            {
              "include": "#raw-html"
            }
          ]
        }
      ]
    },
    "raw-html": {
      "begin": "`",
      "beginCaptures": {
        "0": {
          "name": "string.quoted.raw.go punctuation.definition.string.begin.go"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "string.quoted.raw.go punctuation.definition.string.end.go"
        }
      },
      "contentName": "meta.embedded.block.html text.html.basic",
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "parens": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.begin.bracket.round.go"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.bracket.round.go"
        }
      },
      "patterns": [
        {
          "include": "#parens"
        },
        {
          "include": "source.go"
        }
      ]
    }
  }
}
